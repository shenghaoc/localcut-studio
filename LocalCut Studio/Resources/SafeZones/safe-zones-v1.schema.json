{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "com.localcutstudio.safe-zones-v1",
  "type": "object",
  "required": ["schemaVersion", "platformID", "displayName", "aspect", "sourceName", "validatedAt", "regions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "platformID": { "type": "string", "minLength": 1 },
    "displayName": { "type": "string", "minLength": 1 },
    "aspect": {
      "enum": ["widescreen16x9", "vertical9x16", "square1x1", "portrait4x5", "custom"]
    },
    "sourceName": { "type": "string", "minLength": 1 },
    "sourceURL": { "type": "string" },
    "validatedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "regions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "points"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "minLength": 1 },
          "points": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "object",
              "required": ["x", "y"],
              "properties": {
                "x": { "type": "number", "minimum": 0, "maximum": 1 },
                "y": { "type": "number", "minimum": 0, "maximum": 1 }
              }
            }
          }
        }
      }
    }
  }
}
